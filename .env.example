# Copy this file to .env and fill in real values.

PORT=5001

# Optional. If left blank the server automatically falls back to an
# in-memory data store, so login/signup work immediately with no setup.
# Set this to a real MongoDB connection string for persistent data
# (jobs, applications, interviews, notifications, saved jobs).
MONGO_URI=

# Any long random string works. Keep it the same between restarts if you
# want previously issued tokens to stay valid.
JWT_SECRET=nexhire_jwt_secret_2026
